{
  "name": "emma-medical-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Emma Medical Portal",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run prisma:generate && nest build --config apps/api/nest-cli.json",
    "start": "node dist/apps/api/main.js",
    "start:dev": "nest start --watch --config apps/api/nest-cli.json",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "admin:create": "npm run prisma:generate && ts-node --project apps/api/tsconfig.json apps/api/src/scripts/admin-create.ts",
    "web:dev": "npm --workspace @emma/web run dev",
    "web:build": "npm --workspace @emma/web run build",
    "web:test": "npm --workspace @emma/web run test",
    "web:start": "serve -s apps/web/dist -l tcp://0.0.0.0:$PORT"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.20.0",
    "jest": "^30.1.3",
    "prisma": "^7.9.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "apps/api/test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "apps/api/tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/api/src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
