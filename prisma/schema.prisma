generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}

enum SystemRole {
  USER
  EMMA_ADMIN
  SERVICE_OPERATOR

  @@map("system_role")
}

enum MembershipRole {
  HOSPITAL_USER
  HOSPITAL_ADMIN

  @@map("membership_role")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

enum StatusHistoryEntityType {
  REPAIR
  INSPECTION

  @@map("status_history_entity_type")
}

enum StatusMappingSourceEntityType {
  REPAIR
  INSPECTION

  @@map("status_mapping_source_entity_type")
}

model Hospital {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  active        Boolean      @default(true)
  portalEnabled Boolean      @default(false) @map("portal_enabled")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  departments   Department[]
  memberships   Membership[]
  activeSessions UserSession[] @relation("ActiveHospitalSessions")
  auditEvents    AuditEvent[]
  devices        Device[]
  contacts       Contact[]
  communicationSettings CommunicationSettings?

  @@map("hospitals")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  hospitalId  String       @map("hospital_id") @db.Uuid
  name        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  hospital    Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  memberships Membership[]
  devices     Device[]

  @@unique([id, hospitalId], map: "departments_id_hospital_id_key")
  @@index([hospitalId], map: "departments_hospital_id_idx")
  @@map("departments")
}

model Device {
  id                String      @id @default(uuid()) @db.Uuid
  hospitalId        String      @map("hospital_id") @db.Uuid
  departmentId      String?     @map("department_id") @db.Uuid
  name              String
  manufacturer      String?
  model             String?
  serialNo          String?     @map("serial_no")
  inventoryNo       String?     @map("inventory_no")
  category          String?
  qrEpc             String?     @map("qr_epc")
  passportNo        String?     @map("passport_no")
  active            Boolean     @default(true)
  sourceSystem      String?     @map("source_system")
  sourceBaseId      String?     @map("source_base_id")
  sourceTableName   String?     @map("source_table_name")
  sourceRecordId    String?     @map("source_record_id")
  sourceUpdatedAt   DateTime?   @map("source_updated_at") @db.Timestamptz(3)
  sourcePayloadHash String?     @map("source_payload_hash")
  sourceDeletedAt   DateTime?   @map("source_deleted_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  hospital          Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department        Department? @relation(fields: [departmentId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  repairs           Repair[]
  inspections       Inspection[]

  @@index([hospitalId], map: "devices_hospital_id_idx")
  @@index([hospitalId, departmentId], map: "devices_hospital_id_department_id_idx")
  @@index([hospitalId, active], map: "devices_hospital_id_active_idx")
  @@index([hospitalId, serialNo], map: "devices_hospital_id_serial_no_idx")
  @@index([hospitalId, inventoryNo], map: "devices_hospital_id_inventory_no_idx")
  @@index([name], map: "devices_name_idx")
  @@map("devices")
}

model Repair {
  id                  String    @id @default(uuid()) @db.Uuid
  deviceId            String    @map("device_id") @db.Uuid
  businessNumber      String    @unique @map("business_number") @db.VarChar(100)
  customerStatusCode  String    @map("customer_status_code")
  customerLabel       String    @map("customer_label")
  isTerminal          Boolean   @default(false) @map("is_terminal")
  reportedAt          DateTime? @map("reported_at") @db.Timestamptz(3)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz(3)
  startedAt           DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  customerDescription String?   @map("customer_description")
  sourceSystem        String?   @map("source_system")
  sourceBaseId        String?   @map("source_base_id")
  sourceTableName     String?   @map("source_table_name")
  sourceRecordId      String?   @map("source_record_id")
  sourceStatus        String?   @map("source_status")
  sourceUpdatedAt     DateTime? @map("source_updated_at") @db.Timestamptz(3)
  sourcePayloadHash   String?   @map("source_payload_hash")
  sourceDeletedAt     DateTime? @map("source_deleted_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  device              Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([deviceId], map: "repairs_device_id_idx")
  @@index([isTerminal], map: "repairs_is_terminal_idx")
  @@index([customerStatusCode], map: "repairs_customer_status_code_idx")
  @@index([reportedAt], map: "repairs_reported_at_idx")
  @@index([updatedAt], map: "repairs_updated_at_idx")
  @@map("repairs")
}

model Inspection {
  id                  String    @id @default(uuid()) @db.Uuid
  deviceId            String    @map("device_id") @db.Uuid
  businessNumber      String    @unique @map("business_number") @db.VarChar(100)
  customerStatusCode  String    @map("customer_status_code")
  customerLabel       String    @map("customer_label")
  result              String?
  isTerminal          Boolean   @default(false) @map("is_terminal")
  plannedAt           DateTime? @map("planned_at") @db.Timestamptz(3)
  performedAt         DateTime? @map("performed_at") @db.Timestamptz(3)
  dueAt               DateTime? @map("due_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  customerDescription String?   @map("customer_description")
  sourceSystem        String?   @map("source_system")
  sourceBaseId        String?   @map("source_base_id")
  sourceTableName     String?   @map("source_table_name")
  sourceRecordId      String?   @map("source_record_id")
  sourceStatus        String?   @map("source_status")
  sourceUpdatedAt     DateTime? @map("source_updated_at") @db.Timestamptz(3)
  sourcePayloadHash   String?   @map("source_payload_hash")
  sourceDeletedAt     DateTime? @map("source_deleted_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  device              Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([deviceId], map: "inspections_device_id_idx")
  @@index([customerStatusCode], map: "inspections_customer_status_code_idx")
  @@index([isTerminal], map: "inspections_is_terminal_idx")
  @@index([plannedAt], map: "inspections_planned_at_idx")
  @@index([dueAt], map: "inspections_due_at_idx")
  @@index([completedAt], map: "inspections_completed_at_idx")
  @@index([updatedAt], map: "inspections_updated_at_idx")
  @@map("inspections")
}

model StatusHistory {
  id            String                  @id @default(uuid()) @db.Uuid
  entityType    StatusHistoryEntityType @map("entity_type")
  entityId      String                  @map("entity_id") @db.Uuid
  oldStatusCode String?                 @map("old_status_code")
  oldLabel      String?                 @map("old_label")
  newStatusCode String                  @map("new_status_code")
  newLabel      String                  @map("new_label")
  changedAt     DateTime                @map("changed_at") @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, changedAt], map: "status_history_entity_changed_at_idx")
  @@index([changedAt], map: "status_history_changed_at_idx")
  @@map("status_history")
}

model StatusMapping {
  id                   String                        @id @default(uuid()) @db.Uuid
  sourceEntityType     StatusMappingSourceEntityType @map("source_entity_type")
  sourceStatus         String                        @map("source_status") @db.VarChar(200)
  customerStatusCode   String                        @map("customer_status_code") @db.VarChar(100)
  customerLabel        String                        @map("customer_label") @db.VarChar(200)
  emailTemplateId      String?                       @map("email_template_id") @db.VarChar(100)
  sendEmail            Boolean                       @default(false) @map("send_email")
  isTerminal           Boolean                       @default(false) @map("is_terminal")
  requiresAction       Boolean                       @default(false) @map("requires_action")
  active               Boolean                       @default(true)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([sourceEntityType, sourceStatus], map: "status_mappings_source_entity_type_source_status_key")
  @@index([sourceEntityType], map: "status_mappings_source_entity_type_idx")
  @@index([active], map: "status_mappings_active_idx")
  @@index([customerStatusCode], map: "status_mappings_customer_status_code_idx")
  @@index([sendEmail], map: "status_mappings_send_email_idx")
  @@map("status_mappings")
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String?       @map("password_hash")
  status          UserStatus    @default(ACTIVE)
  systemRole      SystemRole    @default(USER) @map("system_role")
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId String?       @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     Membership[]
  sessions        UserSession[]
  deletedBy       User?         @relation("UserSoftDeletes", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedUsers    User[]        @relation("UserSoftDeletes")
  auditEvents     AuditEvent[]   @relation("AuditEventActor")
  linkedContacts  Contact[]      @relation("ContactLinkedUser")

  @@index([deletedAt], map: "users_deleted_at_idx")
  @@index([deletedByUserId], map: "users_deleted_by_user_id_idx")
  @@map("users")
}

model Contact {
  id                String    @id @default(uuid()) @db.Uuid
  hospitalId        String    @map("hospital_id") @db.Uuid
  name              String
  email             String    @db.VarChar(320)
  phone             String?
  jobTitle          String?   @map("job_title")
  active            Boolean   @default(true)
  linkedUserId      String?   @map("linked_user_id") @db.Uuid
  sourceSystem      String?   @map("source_system")
  sourceBaseId      String?   @map("source_base_id")
  sourceTableName   String?   @map("source_table_name")
  sourceRecordId    String?   @map("source_record_id")
  sourceUpdatedAt   DateTime? @map("source_updated_at") @db.Timestamptz(3)
  sourcePayloadHash String?   @map("source_payload_hash")
  sourceDeletedAt   DateTime? @map("source_deleted_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  hospital          Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  linkedUser        User?     @relation("ContactLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  primaryFor        CommunicationSettings[] @relation("PrimaryContact")
  communicationRecipients CommunicationRecipient[]

  @@unique([hospitalId, email], map: "contacts_hospital_id_email_key")
  @@index([hospitalId], map: "contacts_hospital_id_idx")
  @@index([hospitalId, active], map: "contacts_hospital_id_active_idx")
  @@index([linkedUserId], map: "contacts_linked_user_id_idx")
  @@index([email], map: "contacts_email_idx")
  @@map("contacts")
}

model CommunicationSettings {
  id               String   @id @default(uuid()) @db.Uuid
  hospitalId       String   @unique @map("hospital_id") @db.Uuid
  enabled          Boolean  @default(false)
  primaryContactId String?  @map("primary_contact_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  hospital         Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  recipients       CommunicationRecipient[]

  @@index([primaryContactId], map: "communication_settings_primary_contact_id_idx")
  @@map("communication_settings")
}

model CommunicationRecipient {
  id                      String   @id @default(uuid()) @db.Uuid
  communicationSettingsId String   @map("communication_settings_id") @db.Uuid
  contactId               String   @map("contact_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  communicationSettings   CommunicationSettings @relation(fields: [communicationSettingsId], references: [id], onDelete: Cascade)
  contact                 Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([communicationSettingsId, contactId], map: "communication_recipients_settings_contact_key")
  @@index([contactId], map: "communication_recipients_contact_id_idx")
  @@map("communication_recipients")
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  actorId     String?      @map("actor_id") @db.Uuid
  action      String
  outcome     AuditOutcome
  entityType  String?      @map("entity_type")
  entityId    String?      @map("entity_id") @db.Uuid
  hospitalId  String?      @map("hospital_id") @db.Uuid
  metadata    Json?
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")
  requestId   String?      @map("request_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?        @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  hospital    Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "audit_events_created_at_idx")
  @@index([actorId, createdAt], map: "audit_events_actor_id_created_at_idx")
  @@index([action, createdAt], map: "audit_events_action_created_at_idx")
  @@index([entityType, entityId], map: "audit_events_entity_type_entity_id_idx")
  @@index([hospitalId, createdAt], map: "audit_events_hospital_id_created_at_idx")
  @@index([outcome, createdAt], map: "audit_events_outcome_created_at_idx")
  @@map("audit_events")
}

model Membership {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  hospitalId   String         @map("hospital_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  role         MembershipRole
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospital     Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department   Department?    @relation(fields: [departmentId, hospitalId], references: [id, hospitalId], onDelete: Restrict)

  @@index([userId], map: "memberships_user_id_idx")
  @@index([hospitalId], map: "memberships_hospital_id_idx")
  @@index([departmentId], map: "memberships_department_id_idx")
  @@map("memberships")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  activeHospitalId String?   @map("active_hospital_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeHospital   Hospital? @relation("ActiveHospitalSessions", fields: [activeHospitalId], references: [id], onDelete: SetNull)

  @@index([userId], map: "user_sessions_user_id_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([activeHospitalId], map: "user_sessions_active_hospital_id_idx")
  @@map("user_sessions")
}
